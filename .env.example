# 复制为 .env 并填入真实值。.env 已被 git 忽略，不会提交。
# CLI/Web/Worker 启动时会自动加载，无需 source 或 export。

# PostgreSQL. Compose derives DATABASE_URL from the values below by default.
# Only set DATABASE_URL when the password contains URL-reserved characters;
# encode the password before putting it in that URL.
# DATABASE_URL=postgresql://paperbase:encoded-password@db:5432/paperbase
POSTGRES_DB=paperbase
POSTGRES_USER=paperbase
POSTGRES_PASSWORD=change-me
PAPERBASE_IMAGE=paperbase:local

# DeepSeek（默认 provider；切换 provider 后改成对应的 key）
DEEPSEEK_API_KEY=

# MinerU PDF 解析
MINERU_API_KEY=

# 可选：迁移阿里云 OSS 后填写
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# 可选：指定配置文件位置，等价于 --config
# PAPERBASE_CONFIG=/opt/paper/config.toml
