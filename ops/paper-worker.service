[Unit]
Description=PaperBase weekly fetch + queued-task drain (one-shot)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=paper
Group=paper
WorkingDirectory=/opt/paper
Environment=PAPERBASE_CONFIG=/opt/paper/config.toml
ExecStart=/opt/paper/venv/bin/python -m paperbase.cli worker --daily
MemoryMax=1G
NoNewPrivileges=true
