[Unit]
Description=PaperBase web server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=paper
Group=paper
WorkingDirectory=/opt/paper
Environment=PAPERBASE_CONFIG=/opt/paper/config.toml
ExecStart=/opt/paper/venv/bin/python -m paperbase.cli web
Restart=always
RestartSec=3
MemoryMax=512M
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
